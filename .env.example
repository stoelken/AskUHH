# Backend → GPU server
OLLAMA_HOST=http://134.100.39.14:11435
INDEXER_HOST=http://134.100.39.14:8500

# Backend (LLM generation only)
LLM_MODEL=qwen3-vl:8b-instruct
TOP_K_IMAGES=2

# Indexer (text + image indexing, passed via docker-compose.gpu.yml)
EMBED_MODEL=snowflake-arctic-embed2
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:Q8_0
VLLM_MODEL=llava:7b
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4
RERANK_CANDIDATES=15

# Ports
FRONTEND_PORT=3123
BACKEND_PORT=8123
